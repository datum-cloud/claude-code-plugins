#!/usr/bin/env bash
set -euo pipefail

NAMESPACE="${NAMESPACE:-telemetry-system}"
SERVICE="${SERVICE:-vmalertmanager-service-alerting}"
BASE_URL=""
MAX_SECONDS=$((72 * 3600))
SCOPE_LABELS="cluster namespace instance"

cleanup() {
  kill "${PORT_FORWARD_PID:-}" >/dev/null 2>&1 || true
  rm -f "${PORT_FORWARD_LOG:-}"
}
trap cleanup EXIT

usage() {
  cat >&2 <<'USAGE'
Usage: alertmanager-silences list
       alertmanager-silences propose <silence flags>
       alertmanager-silences create <silence flags>

Reads the active Alertmanager silences, and writes one narrow silence after a
person approves it. Needs kubectl, curl and jq. CONTEXT must name the
production kubectl context; there is no default.

  list      prints id, matchers, end time, author and comment, tab-separated;
            matchers are comma-separated as name=value, name!=value,
            name=~regex or name!~regex, the same operators amtool shows
  propose   checks the silence and prints it, without contacting Alertmanager
  create    checks the silence again, refuses a duplicate of an active one,
            and writes it

Silence flags, all required:

  --alertname NAME   the one alert to silence, matched exactly
  --match NAME=VALUE an exact matcher; repeat it, and include at least one of
                     cluster, namespace or instance
  --for DURATION     30m, 24h or 3d; at most 72h
  --issue URL        the GitHub issue tracking the fire
  --approved-by WHO  the person who approved this silence in the session

Every matcher is an exact equality. Regex and negative matchers are refused,
because either can widen a silence past the one alert it was approved for.

  NAMESPACE   defaults to telemetry-system
  SERVICE     defaults to vmalertmanager-service-alerting

The local port is one the kernel assigns to this run's own port-forward, read
from kubectl's output, so a forward another session left running cannot
answer in its place.
USAGE
  exit 2
}

fail() {
  echo "ERROR: $*" >&2
  exit 1
}

require_context() {
  [[ -n "${CONTEXT:-}" ]] || fail "set CONTEXT to the production kubectl context"
}

iso_utc() {
  date -u -r "$1" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null ||
    date -u -d "@$1" +%Y-%m-%dT%H:%M:%SZ
}

duration_seconds() {
  local spec="$1"

  if [[ ! "$spec" =~ ^([0-9]+)([mhd])$ ]]; then
    fail "--for must look like 30m, 24h or 3d, got: $spec"
  fi

  case "${BASH_REMATCH[2]}" in
  m) echo $((10#${BASH_REMATCH[1]} * 60)) ;;
  h) echo $((10#${BASH_REMATCH[1]} * 3600)) ;;
  d) echo $((10#${BASH_REMATCH[1]} * 86400)) ;;
  esac
}

start_port_forward() {
  PORT_FORWARD_LOG=$(mktemp)
  kubectl --context "$CONTEXT" port-forward -n "$NAMESPACE" "svc/$SERVICE" \
    --address 127.0.0.1 ":9093" >"$PORT_FORWARD_LOG" 2>&1 &
  PORT_FORWARD_PID=$!

  local attempt port
  for attempt in $(seq 1 30); do
    if ! kill -0 "$PORT_FORWARD_PID" 2>/dev/null; then
      break
    fi
    port=$(sed -n 's/^Forwarding from 127\.0\.0\.1:\([0-9][0-9]*\) -> 9093$/\1/p' \
      "$PORT_FORWARD_LOG" | head -n 1)
    if [[ -n "$port" ]]; then
      BASE_URL="http://127.0.0.1:$port"
      if curl -sf "$BASE_URL/-/healthy" >/dev/null 2>&1; then
        return 0
      fi
    fi
    sleep 1
  done

  echo "ERROR: $SERVICE in $NAMESPACE on context $CONTEXT did not answer through this run's port-forward" >&2
  sed 's/^/  kubectl: /' "$PORT_FORWARD_LOG" >&2
  exit 1
}

fetch_active() {
  local body
  body=$(curl -sf "$BASE_URL/api/v2/silences") ||
    fail "could not read silences from $BASE_URL"

  jq -e 'type == "array"' >/dev/null 2>&1 <<<"$body" ||
    fail "silences endpoint did not return a JSON array"

  jq '[.[] | select(.status.state == "active")]' <<<"$body"
}

do_list() {
  local active count

  require_context
  start_port_forward
  active=$(fetch_active)
  count=$(jq 'length' <<<"$active")

  if [[ "$count" -eq 0 ]]; then
    echo "No active silences on $CONTEXT"
    return 0
  fi

  jq -r '.[] | [
    .id,
    (.matchers | map(.name + (
      if .isEqual == false then (if .isRegex then "!~" else "!=" end)
      else (if .isRegex then "=~" else "=" end) end
    ) + .value) | join(",")),
    .endsAt,
    .createdBy,
    .comment
  ] | @tsv' <<<"$active"

  echo "$count active silence(s) on $CONTEXT" >&2
}

build_silence() {
  local alertname="" duration="" issue="" approver=""
  local matches=() match name value scoped=false seconds now_epoch
  local matcher_json

  while [[ $# -gt 0 ]]; do
    [[ -n "${2:-}" ]] || usage
    case "$1" in
    --alertname) alertname="$2" ;;
    --match) matches+=("$2") ;;
    --for) duration="$2" ;;
    --issue) issue="$2" ;;
    --approved-by) approver="$2" ;;
    *) usage ;;
    esac
    shift 2
  done

  [[ -n "$alertname" && -n "$duration" && -n "$issue" && -n "$approver" ]] ||
    fail "--alertname, --for, --issue and --approved-by are all required"

  [[ "$alertname" =~ ^[A-Za-z_:][A-Za-z0-9_:]*$ ]] ||
    fail "--alertname must be one alert name, got: $alertname"

  [[ "$issue" =~ ^https://github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/issues/[0-9]+$ ]] ||
    fail "--issue must be a GitHub issue URL, got: $issue"

  [[ ${#matches[@]} -gt 0 ]] ||
    fail "at least one --match on cluster, namespace or instance is required"

  matcher_json=$(jq -n --arg v "$alertname" \
    '[{name: "alertname", value: $v, isRegex: false, isEqual: true}]')

  for match in "${matches[@]}"; do
    case "$match" in
    *'=~'* | *'!='* | *'!~'*)
      fail "only exact matchers are allowed, got: $match"
      ;;
    *=*) ;;
    *)
      fail "--match must be NAME=VALUE, got: $match"
      ;;
    esac

    name="${match%%=*}"
    value="${match#*=}"

    [[ "$name" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] ||
      fail "matcher name must be a label name, got: $name"
    [[ "$name" != "alertname" ]] ||
      fail "pass the alert name with --alertname, not --match"
    [[ -n "$value" ]] ||
      fail "matcher $name has an empty value, which matches every series without that label"

    case " $SCOPE_LABELS " in
    *" $name "*) scoped=true ;;
    esac

    matcher_json=$(jq --arg n "$name" --arg v "$value" \
      '. + [{name: $n, value: $v, isRegex: false, isEqual: true}]' <<<"$matcher_json")
  done

  [[ "$scoped" == true ]] ||
    fail "include a --match on cluster, namespace or instance so the silence cannot reach the whole fleet"

  seconds=$(duration_seconds "$duration")
  [[ "$seconds" -gt 0 ]] || fail "--for must be longer than zero"
  [[ "$seconds" -le "$MAX_SECONDS" ]] ||
    fail "--for is capped at 72h, got: $duration"

  now_epoch=$(date -u +%s)

  jq -n --argjson matchers "$matcher_json" \
    --arg s "$(iso_utc "$now_epoch")" \
    --arg e "$(iso_utc $((now_epoch + seconds)))" \
    --arg by "$approver" \
    --arg c "Tracked in $issue. Proposed by the warden patrol, approved by $approver." \
    '{matchers: $matchers, startsAt: $s, endsAt: $e, createdBy: $by, comment: $c}'
}

do_propose() {
  local silence
  silence=$(build_silence "$@")
  printf '%s\n' "$silence"
  echo "Proposal only. Nothing was written to Alertmanager." >&2
}

do_create() {
  local silence existing response id

  require_context
  silence=$(build_silence "$@")

  start_port_forward
  existing=$(fetch_active)

  if jq -e --argjson want "$silence" \
    'any(.[]; (.matchers | map({name, value, isRegex, isEqual}) | sort) == ($want.matchers | sort))' \
    >/dev/null <<<"$existing"; then
    fail "an active silence on $CONTEXT already has these matchers; nothing was written"
  fi

  response=$(printf '%s\n' "$silence" |
    curl -sf -X POST -H 'Content-Type: application/json' --data @- \
      "$BASE_URL/api/v2/silences") ||
    fail "could not create the silence on $BASE_URL"

  id=$(jq -r '.silenceID // .id // empty' <<<"$response")
  [[ -n "$id" ]] || fail "Alertmanager accepted the silence but named no id"

  echo "Created silence $id on $CONTEXT, expires $(jq -r .endsAt <<<"$silence")"
}

case "${1:-}" in
list)
  do_list
  ;;
propose)
  shift
  do_propose "$@"
  ;;
create)
  shift
  do_create "$@"
  ;;
*)
  usage
  ;;
esac
