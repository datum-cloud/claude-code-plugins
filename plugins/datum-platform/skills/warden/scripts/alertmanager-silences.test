#!/usr/bin/env bash
# Runs alertmanager-silences against a stubbed kubectl and curl, so no case
# reaches a cluster. Exits non-zero when any case fails or when no case ran.

set -uo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
script="${here}/alertmanager-silences"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

pass=0
fail=0
stub_dir="${tmp}/stub"
mkdir -p "$stub_dir"

cat >"${stub_dir}/kubectl" <<'EOF'
#!/usr/bin/env bash
case "$*" in
*port-forward*) exec sleep 30 ;;
esac
EOF

cat >"${stub_dir}/curl" <<EOF
#!/usr/bin/env bash
case "\$*" in
*"-X POST"*)
  cat >"${tmp}/posted"
  echo '{"silenceID":"new"}'
  ;;
*"/-/healthy"*) exit 0 ;;
*"/api/v2/silences"*) cat "${tmp}/served" ;;
*) exit 1 ;;
esac
EOF
chmod +x "${stub_dir}/kubectl" "${stub_dir}/curl"

run() {
  PATH="${stub_dir}:${PATH}" CONTEXT=test LOCAL_PORT=1 "$script" "$@"
}

refuses() { # name  stderr-fragment  args...
  local name="$1" want="$2" out
  shift 2
  if out=$(run "$@" 2>&1); then
    fail=$((fail + 1))
    printf 'FAIL: %s\n  exited zero:\n%s\n' "$name" "$out"
  elif [[ "$out" != *"$want"* ]]; then
    fail=$((fail + 1))
    printf 'FAIL: %s\n  want stderr containing: %s\n  got: %s\n' "$name" "$want" "$out"
  else
    pass=$((pass + 1))
  fi
}

check() { # name  want  got
  if [[ "$2" == "$3" ]]; then
    pass=$((pass + 1))
  else
    fail=$((fail + 1))
    printf 'FAIL: %s\n  want: %s\n  got:  %s\n' "$1" "$2" "$3"
  fi
}

issue=https://github.com/datum-cloud/engineering/issues/1
ok=(--alertname FooDown --match cluster=prod-infrastructure-control-plane
  --for 24h --issue "$issue" --approved-by alice)

refuses "regex matcher" "only exact matchers" \
  propose --alertname FooDown --match 'cluster=~prod.*' --for 1h --issue "$issue" --approved-by alice
refuses "negative matcher" "only exact matchers" \
  propose --alertname FooDown --match 'cluster!=staging' --for 1h --issue "$issue" --approved-by alice
refuses "unscoped matcher" "cluster, namespace or instance" \
  propose --alertname FooDown --match team=infra --for 1h --issue "$issue" --approved-by alice
refuses "no matcher" "at least one --match" \
  propose --alertname FooDown --for 1h --issue "$issue" --approved-by alice
refuses "empty value" "empty value" \
  propose --alertname FooDown --match cluster= --for 1h --issue "$issue" --approved-by alice
refuses "alertname as matcher" "--alertname" \
  propose --alertname FooDown --match alertname=Bar --match cluster=x --for 1h --issue "$issue" --approved-by alice
refuses "regex alertname" "one alert name" \
  propose --alertname 'Foo.*' --match cluster=x --for 1h --issue "$issue" --approved-by alice
refuses "expiry over 72h" "capped at 72h" \
  propose --alertname FooDown --match cluster=x --for 4d --issue "$issue" --approved-by alice
refuses "zero expiry" "longer than zero" \
  propose --alertname FooDown --match cluster=x --for 0h --issue "$issue" --approved-by alice
refuses "bad duration" "--for must look like" \
  propose --alertname FooDown --match cluster=x --for 1w --issue "$issue" --approved-by alice
refuses "issue not a URL" "GitHub issue URL" \
  propose --alertname FooDown --match cluster=x --for 1h --issue '#12' --approved-by alice
refuses "no approver" "all required" \
  propose --alertname FooDown --match cluster=x --for 1h --issue "$issue"

proposal=$(run propose "${ok[@]}" 2>/dev/null)
check "propose matchers" \
  '[{"name":"alertname","value":"FooDown","isRegex":false,"isEqual":true},{"name":"cluster","value":"prod-infrastructure-control-plane","isRegex":false,"isEqual":true}]' \
  "$(jq -c .matchers <<<"$proposal")"
check "propose author" alice "$(jq -r .createdBy <<<"$proposal")"
check "propose comment names the issue" yes \
  "$(jq -r --arg i "$issue" 'if (.comment | contains($i)) then "yes" else "no" end' <<<"$proposal")"
check "propose writes nothing" no "$([[ -f "${tmp}/posted" ]] && echo yes || echo no)"

unset_ctx_out=$(PATH="${stub_dir}:${PATH}" CONTEXT='' LOCAL_PORT=1 "$script" create "${ok[@]}" 2>&1)
check "create refuses an empty CONTEXT" 1 "$(grep -c 'set CONTEXT' <<<"$unset_ctx_out")"

echo '[]' >"${tmp}/served"
created=$(run create "${ok[@]}" 2>&1)
check "create reports the id" 1 "$(grep -c 'Created silence new on test' <<<"$created")"
check "create posts the proposal's matchers" \
  "$(jq -c .matchers <<<"$proposal")" "$(jq -c .matchers "${tmp}/posted")"

rm -f "${tmp}/posted"
jq -n --argjson m "$(jq .matchers <<<"$proposal")" \
  '[{id: "s1", matchers: $m, status: {state: "active"}, endsAt: "2099-01-01T00:00:00Z", createdBy: "bob", comment: "x"}]' \
  >"${tmp}/served"
refuses "duplicate of an active silence" "already has these matchers" \
  create "${ok[@]}"
check "duplicate writes nothing" no "$([[ -f "${tmp}/posted" ]] && echo yes || echo no)"

listed=$(run list 2>/dev/null)
check "list prints matchers" \
  "s1	alertname=FooDown,cluster=prod-infrastructure-control-plane	2099-01-01T00:00:00Z	bob	x" \
  "$listed"

echo "${pass} passed, ${fail} failed"
[[ "$pass" -gt 0 && "$fail" -eq 0 ]]
